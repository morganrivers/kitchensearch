873" y="167"/><mxPoint x="1873" y="167"/><mxPoint x="1018" y="228"/><mxPoint x="1018" y="228"/><mxPoint x="1018" y="228"/><mxPoint x="994" y="290"/></Array></mxGeometry></mxCell><mxCell id="e43" value="GET combo PNG" style="edgeStyle=none;curved=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa6b3;fontSize=9;fontColor=#5b6675;strokeColor=#3d72b4;dashed=1;" edge="1" parent="1" source="cdn" target="story"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2366" y="231"/><mxPoint x="2356" y="228"/><mxPoint x="2356" y="228"/><mxPoint x="2356" y="228"/><mxPoint x="2183" y="188"/></Array></mxGeometry></mxCell><mxCell id="e44" value="get_thumb → cache PNG" style="edgeStyle=none;curved=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa6b3;fontSize=9;fontColor=#5b6675;strokeColor=#b98a1e;dashed=1;" edge="1" parent="1" source="story" target="thumbs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1919" y="101"/><mxPoint x="1886" y="80"/></Array></mxGeometry></mxCell><object id="e45" label="build_png() → emoji-story.png" link="https://github.com/morganrivers/kitchensearch/blob/main/emoji-story.png"><mxCell style="edgeStyle=none;curved=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa6b3;fontSize=9;fontColor=#5b6675;strokeColor=#b98a1e;dashed=1;" edge="1" parent="1" source="story" target="storypng"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1988" y="102"/><mxPoint x="1991" y="84"/></Array></mxGeometry></mxCell></object><mxCell id="e46" value="picker.show_image()" style="edgeStyle=none;curved=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa6b3;fontSize=9;fontColor=#5b6675;strokeColor=#3d72b4;dashed=1;" edge="1" parent="1" source="storypng" target="app"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2206" y="106"/><mxPoint x="2532" y="228"/><mxPoint x="2532" y="228"/><mxPoint x="2532" y="228"/><mxPoint x="2532" y="284"/><mxPoint x="2532" y="284"/><mxPoint x="2532" y="284"/><mxPoint x="2002" y="603"/><mxPoint x="2002" y="603"/><mxPoint x="2002" y="603"/><mxPoint x="2002" y="674"/><mxPoint x="2002" y="674"/><mxPoint x="2002" y="674"/><mxPoint x="2133" y="735"/><mxPoint x="2133" y="735"/><mxPoint x="2133" y="735"/><mxPoint x="2133" y="800"/><mxPoint x="2133" y="800"/><mxPoint x="2133" y="800"/><mxPoint x="2100" y="1427"/><mxPoint x="2100" y="1427"/><mxPoint x="2100" y="1427"/><mxPoint x="2080" y="1454"/></Array></mxGeometry></mxCell><mxCell id="e47" value="copy_image_to_clipboard (story png)" style="edgeStyle=none;curved=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa6b3;fontSize=9;fontColor=#5b6675;strokeColor=#2e8b57;" edge="1" parent="1" source="app" target="pu_clip"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2032" y="1469"/><mxPoint x="2032" y="1446"/></Array></mxGeometry></mxCell><object label="kitchensearch_daemon&lt;br&gt;(hotkey / tray)&lt;br&gt;kitchensearch_daemon.py" tooltip="&lt;b&gt;kitchensearch_daemon.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;Background launcher. Windows: registers a global hotkey (default Ctrl+Alt+K) + system-tray icon and adds itself to Run for auto-start. macOS: hosts a rumps menu-bar icon. Both spawn kitchensearch.py as a subprocess when the user triggers it. Linux binds a shortcut via the .desktop file instead. Shares picker-settings.json with the app for the hotkey value." link="https://github.com/morganrivers/kitchensearch/blob/main/kitchensearch_daemon.py" id="daemon"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dfe7ef;strokeColor=#6b7f96;fontColor=#1b2733;" vertex="1" parent="1"><mxGeometry x="1944" y="1614" width="175" height="65" as="geometry"/></mxCell></object><object label="kitchensearch.py&lt;br&gt;main() menu loop&lt;br&gt;kitchensearch.py" tooltip="&lt;b&gt;kitchensearch.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;Application entry point. main() loads settings, builds the LicenseManager, constructs the TkPicker, loads the search index once, and runs the front-menu loop dispatching to keyword / semantic / combo / story / favorites / settings. Owns all mode handlers and the copy/copy-at-size/favorite closures passed into the picker (copy-at-size resolves alt→url and calls copy_url_at_size at the requested render size, defaulting to the copy_size setting)." link="https://github.com/morganrivers/kitchensearch/blob/main/kitchensearch.py" id="app"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dfe7ef;strokeColor=#6b7f96;fontColor=#1b2733;" vertex="1" parent="1"><mxGeometry x="1967" y="1488" width="129" height="65" as="geometry"/></mxCell></object><object label="picker_ui&lt;br&gt;TkPicker&lt;br&gt;ksapp/picker_ui.py" tooltip="&lt;b&gt;ksapp/picker_ui.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;The whole Tk GUI (2800+ lines): borderless half-screen picker, virtualized image result rows with lazy thumbnail loading, dark-mode + zoom, loading/progress bars, story preview, and a small/medium/large copy-size button bar under result views (plus 1-5 digit keys and Ctrl+C) for copying the selected combo at a chosen size. pick_with_images(entries, on_url, on_select, on_favorite, on_copy_size) is the workhorse; on_url is picker_utils.get_thumb, on_select/on_favorite/on_copy_size are closures from kitchensearch.py." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/picker_ui.py" id="ui"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#cfe8e6;strokeColor=#4f9b95;fontColor=#163a37;" vertex="1" parent="1"><mxGeometry x="1695" y="1245" width="142" height="65" as="geometry"/></mxCell></object><object label="placeholder_entry&lt;br&gt;ksapp/placeholder_entry.py" tooltip="&lt;b&gt;ksapp/placeholder_entry.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;PlaceholderManager: greyed placeholder text for the search Entry, restored on blur. Imported by picker_ui for the filter/search box." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/placeholder_entry.py" id="placeholder"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#cfe8e6;strokeColor=#4f9b95;fontColor=#163a37;" vertex="1" parent="1"><mxGeometry x="1442" y="1127" width="195" height="50" as="geometry"/></mxCell></object><object label="zoom&lt;br&gt;ZoomManager&lt;br&gt;ksapp/zoom.py" tooltip="&lt;b&gt;ksapp/zoom.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;ZoomManager: Ctrl+= / Ctrl+- / Ctrl+0 / Ctrl+MouseWheel zoom factor for the picker UI. Reports the new factor back through on_zoom_change so kitchensearch.py persists it in settings." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/zoom.py" id="zoom"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#cfe8e6;strokeColor=#4f9b95;fontColor=#163a37;" vertex="1" parent="1"><mxGeometry x="1301" y="1119" width="109" height="65" as="geometry"/></mxCell></object><object label="font_setup&lt;br&gt;ksapp/font_setup.py" tooltip="&lt;b&gt;ksapp/font_setup.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;apply(root): on Linux registers the bundled Liberation Sans TTF with fontconfig (FcConfigAppFontAddFile) and points every Tk named font at it so UI text renders anti-aliased through Xft. No-op on macOS/Windows which ship good UI fonts." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/font_setup.py" id="fontsetup"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#cfe8e6;strokeColor=#4f9b95;fontColor=#163a37;" vertex="1" parent="1"><mxGeometry x="1870" y="1127" width="149" height="50" as="geometry"/></mxCell></object><object label="picker_utils&lt;br&gt;search · thumbs · clipboard · IPC&lt;br&gt;ksapp/picker_utils.py" tooltip="&lt;b&gt;ksapp/picker_utils.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;Shared core hub. load_index() -&gt; entries (url, alt, text); search() keyword ranking; build_base_emoji_index(); get_thumb() download+cache; copy_image_to_clipboard(); copy_url_at_size()/sized_url()/COPY_SIZES for copying a combo at a chosen render size (=sN, native 534 ceiling); record_copy(); favorites read/write; and the split-daemon lifecycle (_spawn_daemon, _daemon_alive, query_daemon over IPC). Calls data_assets.ensure_data() at import." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/picker_utils.py" id="utils"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e6d6f2;strokeColor=#8a5fb0;fontColor=#3d2757;" vertex="1" parent="1"><mxGeometry x="1433" y="861" width="241" height="65" as="geometry"/></mxCell></object><object label="data_assets&lt;br&gt;ensure_data&lt;br&gt;ksapp/data_assets.py" tooltip="&lt;b&gt;ksapp/data_assets.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;ensure_data(): on first run, if data/ui_assets/search-index.tsv is missing, unpacks the committed app_assets.tar.gz into ksapp/ (ui_assets/ text corpora + fonts/). Invoked at picker_utils import, by font_setup, and by the split daemon." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/data_assets.py" id="dataassets"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e6d6f2;strokeColor=#8a5fb0;fontColor=#3d2757;" vertex="1" parent="1"><mxGeometry x="1161" y="861" width="156" height="65" as="geometry"/></mxCell></object><object label="license&lt;br&gt;LicenseManager&lt;br&gt;ksapp/license.py" tooltip="&lt;b&gt;ksapp/license.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;LicenseManager: gates Favorites + dark-mode behind a Polar.sh license key. is_licensed() is a fast offline check against cached license.json; activate/validate/deactivate hit Polar&#x27;s customer-portal API. refresh_async() re-validates in a background thread." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/license.py" id="license"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e6d6f2;strokeColor=#8a5fb0;fontColor=#3d2757;" vertex="1" parent="1"><mxGeometry x="1988" y="735" width="129" height="65" as="geometry"/></mxCell></object><object label="ssl_ctx&lt;br&gt;(shared TLS)&lt;br&gt;ksapp/ssl_ctx.py" tooltip="&lt;b&gt;ksapp/ssl_ctx.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;ssl_ctx(): single source of truth for the TLS SSLContext used by every outbound HTTPS call (thumbnail downloads in picker_utils and emoji_story, license API in license.py)." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/ssl_ctx.py" id="sslctx"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e6d6f2;strokeColor=#8a5fb0;fontColor=#3d2757;" vertex="1" parent="1"><mxGeometry x="1738" y="861" width="129" height="65" as="geometry"/></mxCell></object><object label="🤖 emoji_split_daemon&lt;br&gt;(IPC search server)&lt;br&gt;ksapp/emoji_split_daemon.py" tooltip="&lt;b&gt;ksapp/emoji_split_daemon.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;Long-lived semantic-search daemon. load() reads the MiniLM model + all embedding arrays once; then serves newline-JSON requests over a Unix socket / Windows named pipe. 1 word -&gt; squared combo; 2 words -&gt; cross-ranked base combos; then text-embedding cosine fallback. Idle-exits after 600s. Writes a loading-% status file during startup." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/emoji_split_daemon.py" id="split"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#cfe6cf;strokeColor=#5a9367;fontColor=#1e3a24;" vertex="1" parent="1"><mxGeometry x="849" y="345" width="222" height="65" as="geometry"/></mxCell></object><object label="🤖 minilm_text&lt;br&gt;(ONNX MiniLM)&lt;br&gt;ksapp/minilm_text.py" tooltip="&lt;b&gt;ksapp/minilm_text.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;MiniLMText: ONNX-runtime wrapper for sentence-transformers/all-MiniLM-L6-v2. load() finds the model in the bundled data/models dir (or the fastembed cache); embed(texts) mean-pools + L2-normalises to 384-d float32 vectors. Used by the split daemon only." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/minilm_text.py" id="minilm"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#cfe6cf;strokeColor=#5a9367;fontColor=#1e3a24;" vertex="1" parent="1"><mxGeometry x="89" y="474" width="176" height="65" as="geometry"/></mxCell></object><object label="emoji_story&lt;br&gt;ksapp/emoji_story.py" tooltip="&lt;b&gt;ksapp/emoji_story.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;Standalone tool (also spawned as a subprocess by the app). Splits text into phrases, queries the split daemon over IPC for the best combo per phrase, downloads each thumbnail, and composes a phrase-per-row PNG via Pillow written to --output." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/emoji_story.py" id="story"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f6d9c0;strokeColor=#c17a3a;fontColor=#5a3410;" vertex="1" parent="1"><mxGeometry x="1905" y="117" width="156" height="50" as="geometry"/></mxCell></object><object label="app_assets.tar.gz&lt;br&gt;(bundled UI assets)&lt;br&gt;ksapp/data/app_assets.tar.gz" tooltip="&lt;b&gt;ksapp/data/app_assets.tar.gz&lt;/b&gt;&lt;br&gt;&lt;br&gt;Committed tarball shipped with the source. Contains the ui_assets/ text corpora (search-index.tsv, base-emoji-codes/names, embedding-urls/alts, urls.txt) and the fonts/ TTFs. Extracted lazily by data_assets.ensure_data on first run so a fresh checkout has no loose data files." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/data/app_assets.tar.gz" id="tar"><mxCell style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e6ecf3;strokeColor=#8493a4;fontColor=#1b2733;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1229" y="987" width="208" height="71" as="geometry"/></mxCell></object><object label="search-index.tsv&lt;br&gt;(ui_assets/, in tarball)" tooltip="The keyword-search corpus: one row per emoji-kitchen combo as url \t alt \t text. load_index() parses it into entries for keyword/combo search, and the split daemon parses it into combo_map keyed by the two base-emoji code points. Unpacked from app_assets.tar.gz." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/data/app_assets.tar.gz" id="searchidx"><mxCell style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e6ecf3;strokeColor=#8493a4;fontColor=#1b2733;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1008" y="740" width="182" height="56" as="geometry"/></mxCell></object><object label="base-emoji-codes.txt / -names.txt&lt;br&gt;(ui_assets/, in tarball)" tooltip="Ordered base-emoji hex code points (codes.txt) with their names (names.txt). The daemon builds code_to_idx from codes.txt so a rank vector over base emojis lines up with base-emoji-minilm.npy. Unpacked from app_assets.tar.gz." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/data/app_assets.tar.gz" id="basecodes"><mxCell style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e6ecf3;strokeColor=#8493a4;fontColor=#1b2733;fontSize=11;" vertex="1" parent="1"><mxGeometry x="363" y="479" width="241" height="56" as="geometry"/></mxCell></object><object label="embedding-urls.txt / -alts.txt&lt;br&gt;(ui_assets/, in tarball)" tooltip="Parallel arrays aligned row-for-row with minilm-pca340.npy: each embedded combo&#x27;s thumbnail URL (urls.txt) and alt name (alts.txt). The daemon zips them with the cosine scores to return ranked results. Unpacked from app_assets.tar.gz." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/data/app_assets.tar.gz" id="emburlsalts"><mxCell style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e6ecf3;strokeColor=#8493a4;fontColor=#1b2733;fontSize=11;" vertex="1" parent="1"><mxGeometry x="701" y="479" width="222" height="56" as="geometry"/></mxCell></object><object label="Liberation + Bubblegum Sans&lt;br&gt;(fonts/, in tarball)" tooltip="Bundled TTFs. Liberation Sans is registered as the anti-aliased Linux UI font by font_setup; Bubblegum Sans is loaded directly by picker_ui for the rainbow title. Unpacked from app_assets.tar.gz." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/data/app_assets.tar.gz" id="font"><mxCell style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e6ecf3;strokeColor=#8493a4;fontColor=#1b2733;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1896" y="995" width="202" height="56" as="geometry"/></mxCell></object><object label="base-emoji-minilm.npy&lt;br&gt;ksapp/data/embeddings/base-emoji-minilm.npy" tooltip="&lt;b&gt;ksapp/data/embeddings/base-emoji-minilm.npy&lt;/b&gt;&lt;br&gt;&lt;br&gt;MiniLM embeddings of each base emoji&#x27;s name, row-aligned with base-emoji-codes.txt. Dotted with the query embedding to rank base emojis for 1- and 2-word searches. Committed directly (part of the semantic-search data tier, separate from the tarball)." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/data/embeddings/base-emoji-minilm.npy" id="baseminilm"><mxCell style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e6ecf3;strokeColor=#8493a4;fontColor=#1b2733;fontSize=11;" vertex="1" parent="1"><mxGeometry x="955" y="479" width="307" height="56" as="geometry"/></mxCell></object><object label="minilm-pca340.npy&lt;br&gt;ksapp/data/embeddings/minilm-pca340.npy" tooltip="&lt;b&gt;ksapp/data/embeddings/minilm-pca340.npy&lt;/b&gt;&lt;br&gt;&lt;br&gt;PCA-reduced (340-d) MiniLM text embeddings for every embedded combo, used for the cosine text-similarity fallback ranking. Row-aligned with embedding-urls/alts. Committed directly." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/data/embeddings/minilm-pca340.npy" id="txtemb"><mxCell style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e6ecf3;strokeColor=#8493a4;fontColor=#1b2733;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1294" y="479" width="281" height="56" as="geometry"/></mxCell></object><object label="minilm-pca340-matrix.npy&lt;br&gt;+ -mean.npy&lt;br&gt;ksapp/data/embeddings/minilm-pca340-matrix.npy" tooltip="&lt;b&gt;ksapp/data/embeddings/minilm-pca340-matrix.npy&lt;/b&gt;&lt;br&gt;&lt;br&gt;The PCA projection: subtract -mean.npy then multiply by -matrix.npy to map a fresh 384-d query embedding into the same 340-d space as minilm-pca340.npy before scoring. Committed directly." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/data/embeddings/minilm-pca340-matrix.npy" id="pca"><mxCell style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e6ecf3;strokeColor=#8493a4;fontColor=#1b2733;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1607" y="471" width="327" height="71" as="geometry"/></mxCell></object><object label="model.onnx&lt;br&gt;+ tokenizer.json&lt;br&gt;ksapp/data/models/all-MiniLM-L6-v2-onnx/model.onnx" tooltip="&lt;b&gt;ksapp/data/models/all-MiniLM-L6-v2-onnx/model.onnx&lt;/b&gt;&lt;br&gt;&lt;br&gt;The all-MiniLM-L6-v2 sentence encoder in ONNX form plus its tokenizer/config, loaded by minilm_text at daemon startup. Committed directly under ksapp/data/models/." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/data/models/all-MiniLM-L6-v2-onnx/model.onnx" id="onnx"><mxCell style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e6ecf3;strokeColor=#8493a4;fontColor=#1b2733;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="603" width="354" height="71" as="geometry"/></mxCell></object><object label="picker-settings.json&lt;br&gt;(user config dir)" tooltip="Persisted UI + behaviour settings (menu layout, dark mode, zoom, floating, exit-on-select, default copy size, and the Windows hotkey). Written by kitchensearch.py save_settings and by the daemon&#x27;s settings dialog; read by both, so it is the single shared config." id="settings"><mxCell style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e6ecf3;strokeColor=#8493a4;fontColor=#1b2733;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2380" y="1371" width="156" height="56" as="geometry"/></mxCell></object><object label="favorites.json&lt;br&gt;(user config dir)" tooltip="User&#x27;s saved combos as {alt, url, text}, most-recent-first, deduped by url. Written by toggle/add/remove_favorite; read by load_favorites for the Favorites menu. Lives in the config dir (user data), so it survives cache trims." id="favorites"><mxCell style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e6ecf3;strokeColor=#8493a4;fontColor=#1b2733;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1288" y="740" width="136" height="56" as="geometry"/></mxCell></object><object label="license.json&lt;br&gt;(user config dir)" tooltip="Cached license state: key, activation_id, valid flag, last_validated_at. LicenseManager.is_licensed() reads it offline; activate/validate/deactivate rewrite it atomically." id="licjson"><mxCell style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e6ecf3;strokeColor=#8493a4;fontColor=#1b2733;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2018" y="610" width="136" height="56" as="geometry"/></mxCell></object><object label="copy_counts.json&lt;br&gt;(user cache dir)" tooltip="Per-URL copy tallies (md5(url) -&gt; {count, alt, variants}) written by record_copy on every clipboard copy. variants lists the md5s of the same combo&#x27;s other size renders (=sN URLs) so _trim_thumb_cache biases eviction toward keeping frequently-copied images and keeps all size variants of a hot combo warm together." id="copycounts"><mxCell style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e6ecf3;strokeColor=#8493a4;fontColor=#1b2733;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1456" y="740" width="129" height="56" as="geometry"/></mxCell></object><object label="thumbs/  (downloaded PNGs)&lt;br&gt;(user cache dir)" tooltip="On-disk cache of downloaded combo thumbnails, named md5(url).png. Each copy size renders a distinct =sN URL, so one combo can have several cached PNGs. Filled by get_thumb (in picker_utils and emoji_story); trimmed to ~200 MB by _trim_thumb_cache, which keeps high copy-count / recently-used images and shares a combo&#x27;s copy count across all its size variants." id="thumbs"><mxCell style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e6ecf3;strokeColor=#8493a4;fontColor=#1b2733;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1708" y="0" width="195" height="56" as="geometry"/></mxCell></object><object label="split-daemon.sock / .pid /&lt;br&gt;-loading.json (cache dir)" tooltip="The daemon&#x27;s runtime coordination files: the Unix socket / named pipe it listens on, the PID record (with start-time for reuse detection) written by _spawn_daemon, and the loading-% status file the picker polls while showing the model-loading bar." id="ipc"><mxCell style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e6ecf3;strokeColor=#8493a4;fontColor=#1b2733;fontSize=11;" vertex="1" parent="1"><mxGeometry x="709" y="228" width="195" height="56" as="geometry"/></mxCell></object><object label="emoji-story.png&lt;br&gt;(user cache dir)" tooltip="The composed emoji-story image emoji_story writes to --output. kitchensearch.py previews it via picker.show_image and, on Enter, copies it to the clipboard." id="storypng"><mxCell style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e6ecf3;strokeColor=#8493a4;fontColor=#1b2733;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1935" y="0" width="129" height="56" as="geometry"/></mxCell></object><object label="Emoji Kitchen CDN&lt;br&gt;(gstatic.com)" tooltip="Google&#x27;s Emoji Kitchen image host. get_thumb fetches each combo PNG on demand from the gstatic URL recorded in the search index, then caches it under thumbs/. The only bulk-image source; nothing is pre-bundled." link="https://emojikitchen.dev" id="cdn"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=45;fillColor=#2f7dc4;strokeColor=#1c4f80;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2380" y="231" width="136" height="50" as="geometry"/></mxCell></object><object label="Polar.sh&lt;br&gt;license API" tooltip="Polar.sh customer-portal license-key endpoints (activate / validate / deactivate). Public, no API token. LicenseManager posts here to reserve/free an activation slot and to periodically re-validate." link="https://polar.sh" id="polar"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=45;fillColor=#2f7dc4;strokeColor=#1c4f80;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2186" y="613" width="96" height="50" as="geometry"/></mxCell></object><object label="OS clipboard&lt;br&gt;(image/PNG)" tooltip="The system clipboard, the app&#x27;s primary output. copy_image_to_clipboard writes the combo/story PNG via the platform path: CF_DIB+PNG on Windows (ctypes), osascript on macOS, an X11 selection owner (python-xlib) or wl-copy/xclip on Linux." id="clip"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=45;fillColor=#2f7dc4;strokeColor=#1c4f80;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1980" y="1253" width="103" height="50" as="geometry"/></mxCell></object><object label="picker_utils" tooltip="picker_utils utility, drawn as a local connector stub instead of a central hub. See the picker_utils node in CORE." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/picker_utils.py" id="pu_ui"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8493a4;fontColor=#5b6675;fontSize=9;dashed=1;" vertex="1" parent="1"><mxGeometry x="1735" y="1134" width="103" height="35" as="geometry"/></mxCell></object><object label="picker_utils" tooltip="picker_utils utility, drawn as a local connector stub instead of a central hub. See the picker_utils node in CORE." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/picker_utils.py" id="pu_searchidx"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8493a4;fontColor=#5b6675;fontSize=9;dashed=1;" vertex="1" parent="1"><mxGeometry x="1048" y="621" width="103" height="35" as="geometry"/></mxCell></object><object label="picker_utils" tooltip="picker_utils utility, drawn as a local connector stub instead of a central hub. See the picker_utils node in CORE." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/picker_utils.py" id="pu_cdn"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8493a4;fontColor=#5b6675;fontSize=9;dashed=1;" vertex="1" parent="1"><mxGeometry x="2396" y="124" width="103" height="35" as="geometry"/></mxCell></object><object label="picker_utils" tooltip="picker_utils utility, drawn as a local connector stub instead of a central hub. See the picker_utils node in CORE." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/picker_utils.py" id="pu_sslctx"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8493a4;fontColor=#5b6675;fontSize=9;dashed=1;" vertex="1" parent="1"><mxGeometry x="1751" y="750" width="103" height="35" as="geometry"/></mxCell></object><object label="picker_utils" tooltip="picker_utils utility, drawn as a local connector stub instead of a central hub. See the picker_utils node in CORE." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/picker_utils.py" id="pu_ipc"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8493a4;fontColor=#5b6675;fontSize=9;dashed=1;" vertex="1" parent="1"><mxGeometry x="755" y="124" width="103" height="35" as="geometry"/></mxCell></object><object label="picker_utils" tooltip="picker_utils utility, drawn as a local connector stub instead of a central hub. See the picker_utils node in CORE." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/picker_utils.py" id="pu_dataassets"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8493a4;fontColor=#5b6675;fontSize=9;dashed=1;" vertex="1" parent="1"><mxGeometry x="1094" y="1005" width="103" height="35" as="geometry"/></mxCell></object><object label="picker_utils" tooltip="picker_utils utility, drawn as a local connector stub instead of a central hub. See the picker_utils node in CORE." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/picker_utils.py" id="pu_thumbs"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8493a4;fontColor=#5b6675;fontSize=9;dashed=1;" vertex="1" parent="1"><mxGeometry x="1754" y="124" width="103" height="35" as="geometry"/></mxCell></object><object label="picker_utils" tooltip="picker_utils utility, drawn as a local connector stub instead of a central hub. See the picker_utils node in CORE." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/picker_utils.py" id="pu_app"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8493a4;fontColor=#5b6675;fontSize=9;dashed=1;" vertex="1" parent="1"><mxGeometry x="1779" y="1382" width="103" height="35" as="geometry"/></mxCell></object><object label="picker_utils" tooltip="picker_utils utility, drawn as a local connector stub instead of a central hub. See the picker_utils node in CORE." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/picker_utils.py" id="pu_clip"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8493a4;fontColor=#5b6675;fontSize=9;dashed=1;" vertex="1" parent="1"><mxGeometry x="1980" y="1382" width="103" height="35" as="geometry"/></mxCell></object><object label="picker_utils" tooltip="picker_utils utility, drawn as a local connector stub instead of a central hub. See the picker_utils node in CORE." link="https://github.com/morganrivers/kitchensearch/blob/main/ksapp/picker_utils.py" id="pu_split"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8493a4;fontColor=#5b6675;fontSize=9;dashed=1;" vertex="1" parent="1"><mxGeometry x="1034" y="239" width="103" height="35" as="geometry"/></mxCell></object></root></mxGraphModel></diagram></mxfile>